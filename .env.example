# Print bridge configuration.
#
# Copy to `.env` for local overrides:  cp .env.example .env
#
# `.env` is gitignored; THIS file is tracked and acts as the fallback, so a fresh clone builds
# a correctly-numbered release without one. A real environment variable beats both files.
#
# Read at dev time and while packaging only. An INSTALLED bridge is configured by its service
# definition instead: the launchd plist on macOS, `bridge.env` on Windows.

# ---------------------------------------------------------------------------- app

# The bridge's version, and the only place to bump it.
#
# Reported by `GET /health`, compiled into the binary by `scripts/package.mjs`, and used for the
# artifact filenames, the macOS bundle version and the Windows installer version. Keep it to
# three numeric parts: the POS terminal compares it against its own MIN_BRIDGE_VERSION and
# silently ignores anything it cannot parse. `npm test` fails if package.json disagrees.
APP_VERSION=1.2.0

# ------------------------------------------------------------------------- runtime

# TCP port to listen on. The POS terminal defaults to http://localhost:9200.
PRINT_BRIDGE_PORT=9200

# Address to bind. 0.0.0.0 serves the whole LAN; 127.0.0.1 accepts only this machine.
#
# Both installers set 127.0.0.1, because a POS served over https can only reach a bridge on
# loopback anyway — every other address is blocked as mixed content before a request is made.
# 0.0.0.0 is kept as the default here so `npm run dev` can be driven from another device.
PRINT_BRIDGE_HOST=0.0.0.0

# ------------------------------------------------------------------- signing (optional)

# Every hook below is a no-op when left empty, which is what produces today's unsigned build.
# Put real values in `.env` (gitignored) — never here.

# Developer ID Application identity: signs the binary, and the .dmg when set.
HANKHA_MACOS_SIGN_IDENTITY=

# Developer ID Installer identity: signs the .pkg.
HANKHA_MACOS_INSTALLER_IDENTITY=

# `notarytool` keychain profile name: notarizes and staples both macOS artifacts.
HANKHA_NOTARY_PROFILE=

# Path to an Authenticode .pfx: signs the Windows exe and setup via osslsigncode.
HANKHA_WINDOWS_PFX=
HANKHA_WINDOWS_PFX_PASSWORD=
