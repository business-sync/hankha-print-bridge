# Print bridge configuration.
#
# Copy to `.env` for local overrides:  cp .env.example .env
#
# `.env` is gitignored; THIS file is tracked and acts as the fallback, so a fresh clone builds
# a correctly-numbered release without one. A real environment variable beats both files.
#
# Read at dev time and while packaging only. An INSTALLED bridge is configured by its service
# definition instead: the launchd plist on macOS, `bridge.env` on Windows.

# ---------------------------------------------------------------------------- app

# The bridge's version, and the only place to bump it.
#
# Reported by `GET /health`, compiled into the binary by `scripts/package.mjs`, and used for the
# artifact filenames, the macOS bundle version and the Windows installer version. Keep it to
# three numeric parts: the POS terminal compares it against its own MIN_BRIDGE_VERSION and
# silently ignores anything it cannot parse. `npm test` fails if package.json disagrees.
APP_VERSION=1.5.0

# ------------------------------------------------------------------------- runtime

# TCP port to listen on. The POS terminal defaults to http://localhost:9200.
PRINT_BRIDGE_PORT=9200

# Address to bind. 0.0.0.0 serves the whole LAN; 127.0.0.1 accepts only this machine.
#
# Both installers set 127.0.0.1, because a POS served over https can only reach a bridge on
# loopback anyway — every other address is blocked as mixed content before a request is made.
# 0.0.0.0 is kept as the default here so `npm run dev` can be driven from another device.
PRINT_BRIDGE_HOST=0.0.0.0

# ─── Printing ─────────────────────────────────────────────────────────────────
# Printers are configured in `printers.json` inside PRINT_BRIDGE_STATE_DIR, not here — see the
# README. These only tune how the queue behaves.

# How many times a job is retried. ONLY jobs that provably did not print are ever retried; a
# failure after the printer accepted any bytes is terminal, whatever this says, because a retry
# there hands the customer a second receipt.
PRINT_BRIDGE_MAX_ATTEMPTS=3
# How long one send may take before it is abandoned.
PRINT_BRIDGE_SEND_TIMEOUT_MS=15000
# How long POST /print blocks. Matched to the POS terminal's own 8s client timeout — waiting
# longer only produces an answer nobody is listening for.
PRINT_BRIDGE_SYNC_TIMEOUT_MS=8000

# ─── Logging ──────────────────────────────────────────────────────────────────
# `text` is the prose an operator is asked to send when printing breaks; `json` is one object per
# line, for a container shipping stdout to a log aggregator. Same fields either way.
PRINT_BRIDGE_LOG_FORMAT=text
# debug | info | warn | error
PRINT_BRIDGE_LOG_LEVEL=info

# ------------------------------------------------------------------- signing (optional)

# Every hook below is a no-op when left empty, which is what produces today's unsigned build.
# Put real values in `.env` (gitignored) — never here.

# Developer ID Application identity: signs the binary, and the .dmg when set.
HANKHA_MACOS_SIGN_IDENTITY=

# Developer ID Installer identity: signs the .pkg.
HANKHA_MACOS_INSTALLER_IDENTITY=

# `notarytool` keychain profile name: notarizes and staples both macOS artifacts.
HANKHA_NOTARY_PROFILE=

# Path to an Authenticode .pfx: signs the Windows exe and setup via osslsigncode.
HANKHA_WINDOWS_PFX=
HANKHA_WINDOWS_PFX_PASSWORD=

# ─── Cloud relay ──────────────────────────────────────────────────────────────
# The API this bridge dials OUT to for print jobs. Outbound-only: no inbound port, no TLS
# certificate here, and it works from behind NAT — which is what lets a phone print through
# this bridge without ever reaching the shop LAN. Enroll with:
#   hankha-print-bridge --enroll <code>     (code from POS Settings > Printing)
PRINT_BRIDGE_RELAY_URL=https://api.hankha.la
# auto | ws | poll. `auto` tries a websocket and quietly falls back to long-polling when the
# server does not offer one — which is the case today, so `auto` and `poll` behave identically
# until the endpoint ships. `ws` refuses to fall back, for testing a server that does have it.
PRINT_BRIDGE_RELAY_TRANSPORT=auto
# Where relay.json (install id + bearer token) is kept. Defaults per OS; set this in a
# container so the credential survives a restart.
PRINT_BRIDGE_STATE_DIR=

# ─── LAN security ─────────────────────────────────────────────────────────────
# Require `Authorization: Bearer <token>` on every route except /health. Empty by default
# because the shipped install binds 127.0.0.1, where the OS is the boundary. Set it whenever
# the bridge binds 0.0.0.0 (a shop box, a container) — otherwise anything on the venue Wi-Fi,
# guest phones included, can drive the printers.
PRINT_BRIDGE_TOKEN=
# Bring your own TLS. Both must be set to serve https. There is deliberately no certificate
# issuance here: see the note on `tlsOptions` in src/server.ts.
PRINT_BRIDGE_TLS_CERT=
PRINT_BRIDGE_TLS_KEY=
